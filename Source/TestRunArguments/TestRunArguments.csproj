<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<OutputType>Exe</OutputType>
		<RootNamespace>RunExecutable</RootNamespace>
		<AssemblyName>TestRunArguments</AssemblyName>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<BaseOutputPath>C:\executables</BaseOutputPath>
	</PropertyGroup>

	<Target Name="CopyExecutable" AfterTargets="Build">
		<Copy SourceFiles="$(TargetDir)TestRunArguments.exe" DestinationFolder="$(MSBuildProjectDirectory)\..\..\..\..\executables" />
	</Target>

	<ItemGroup>
	  <PackageReference Include="System.Drawing.Common" Version="9.0.9" />
	</ItemGroup>
</Project>