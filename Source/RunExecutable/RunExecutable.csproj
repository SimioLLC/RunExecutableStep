<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<OutputType>Library</OutputType>
		<RootNamespace>RunExecutable</RootNamespace>
		<AssemblyName>RunExecutable</AssemblyName>
	</PropertyGroup>
	<PropertyGroup>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
	</PropertyGroup>
    <Target Name="PostBuild" AfterTargets="PostBuildEvent">
      <MakeDir Directories="..\..\..\..\executables" Condition="!Exists('..\..\..\..\executables')" />
      <Exec Command="copy /Y &quot;$(TargetDir)RunExecutable.dll&quot; &quot;%UserProfile%\documents\SimioUserExtensions&quot;" />
      <Exec Command="copy /Y &quot;$(TargetDir)RunExecutable.pdb&quot; &quot;%UserProfile%\documents\SimioUserExtensions&quot;" />
      <Exec Command="copy /Y &quot;$(TargetDir)RunExecutable.dll&quot; &quot;..\..\..\..\executables&quot;" ContinueOnError="true" />
    </Target>
	<ItemGroup>
	  <PackageReference Include="System.Drawing.Common" Version="9.0.9" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="SimioAPI">
			<HintPath>..\..\..\..\..\..\..\..\Program Files\Simio LLC\Simio\SimioAPI.dll</HintPath>
		</Reference>
		<Reference Include="SimioAPI.Extensions">
			<HintPath>..\..\..\..\..\..\..\..\Program Files\Simio LLC\Simio\SimioAPI.Extensions.dll</HintPath>
		</Reference>
	</ItemGroup>
	
</Project>